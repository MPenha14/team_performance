# ==============================
# Servidor
# ==============================
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================
# Banco de dados PostgreSQL
# ==============================
DATABASE_URL="postgresql://usuario:senha@localhost:5432/media_performance?schema=public"

# ==============================
# API Dr.Click
# ==============================
DRCLICK_API_URL=https://api-maissaude.drclick.com.br
# /api/reports/schedulesofday aceita sem token real, mas
# /api/reports/appointmentbystatus (usado em Performance) EXIGE um
# DRCLICK_AUTHORIZATION valido - sem ele, "Agendamentos Atendidos" e
# "Conversao" ficam zerados.
DRCLICK_TOKEN=
DRCLICK_AUTHORIZATION=Bearer COLOCAR_TOKEN_REAL_AQUI

# IDs das clinicas (separados por virgula, sem espacos)
DRCLICK_CLINIC_IDS=12706efb-9be9-47d6-a997-7a910c57ef4a,3d55137b-221b-4e98-bf8f-802f49848bbf,3fe2145e-ec64-442b-a967-864afb4d4393,4789e97d-c710-4a83-ab03-66e9a9a55428,801b69e2-eb43-4292-80ba-77c8416d9757,8e0f9a74-ab0e-421d-a037-720ffc1392b7,960d2a28-b716-481c-951f-8b9a5bf1feec,b9b196f3-122f-4eb6-80d1-629d9ff37838,bf7f6157-8775-4766-be38-8aa34ec07070,d0ed8f70-2502-4173-9d0f-71fd45f28ee7,d24730aa-27e0-4666-9b1a-3cc220e2311b,f09c72bf-27ab-40b2-a15e-ec1ffed9e579

# ID do canal de atendimento "Telefonia" (idcanalatendimento na API do Dr.Click)
DRCLICK_TELEFONIA_CHANNEL_ID=32d2e7f9-58b5-469b-a62e-97cfecaceb6b

# ==============================
# Sincronizacao automatica
# ==============================
SYNC_CRON_ENABLED=true
SYNC_CRON_EXPRESSION=*/15 * * * *

# ==============================
# Autenticacao (login do sistema)
# ==============================
ADMIN_EMAIL=admin@clinica.com
ADMIN_PASSWORD=admin123
# Gere um valor aleatorio proprio em producao, ex.: openssl rand -hex 48
JWT_SECRET=COLOCAR_UM_SEGREDO_ALEATORIO_AQUI
